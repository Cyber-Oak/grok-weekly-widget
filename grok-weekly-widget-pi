class UsageError(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


class Credentials:
    def __init__(
        self,
        token: str,
        user_id: str | None,
        expired: bool,
        refresh_token: str | None = None,
        issuer: str | None = None,
        client_id: str | None = None,
        entry_key: str | int | None = None,
        expires: datetime | None = None,
    ) -> None:
        self.token = token
        self.user_id = user_id
        self.expired = expired
        self.refresh_token = refresh_token
        self.issuer = issuer
        self.client_id = client_id
        self.entry_key = entry_key
        self.expires = expires

    def __repr__(self) -> str:
        state = "expired" if self.expired else "active"
        who = "set" if self.user_id else "missing"
        refresh = "set" if self.refresh_token else "missing"
        return f"Credentials({state}, user_id={who}, refresh_token={refresh})"


class Usage:
    def __init__(self, percent: float, resets_at: datetime | None) -> None:
        self.percent = percent
        self.resets_at = resets_at


class Result:
    def __init__(
        self, ok: bool, text: str, percent: float | None, resets_at: datetime | None = None,
    ) -> None:
        self.ok = ok
        self.text = text
        self.percent = percent
        self.resets_at = resets_at


def auth_file() -> str:
    override = os.environ.get("GROK_AUTH_FILE")
    if override:
        return os.path.expanduser(override)
    return os.path.expanduser("~/.grok/auth.json")


def parse_time(value: object) -> datetime | None:
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    # Keep the first six fractional digits so older Pythons accept the stamp.
    dot = text.find(".")
    if dot != -1:
        end = dot + 1
        while end < len(text) and text[end].isdigit():
            end += 1
        text = text[: dot + 1] + text[dot + 1 : end][:6] + text[end:]
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def header_value(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text or any(char in text for char in "\r\n\x00"):
        return None
    return text


def as_percent(value: object) -> float | None:
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, (int, float)):
        return float(value)
    if isinstance(value, str):
        try:
            return float(value.strip().rstrip("%"))
        except ValueError:
            return None
    if isinstance(value, dict):
        for key in ("val", "percent", "usagePercent", "value"):
            found = as_percent(value.get(key))
            if found is not None:
                return found
    return None


def jwt_parts(token: str) -> tuple[datetime | None, str | None]:
    pieces = token.split(".")
    if len(pieces) < 2:
        return None, None
    payload = pieces[1]
    payload += "=" * (-len(payload) % 4)
    try:
        claims = json.loads(base64.urlsafe_b64decode(payload))
    except (ValueError, TypeError):
        return None, None
    if not isinstance(claims, dict):
        return None, None
    exp = claims.get("exp")
    expires = None
    if isinstance(exp, (int, float)) and not isinstance(exp, bool):
        try:
            expires = datetime.fromtimestamp(exp, timezone.utc)
        except (OverflowError, OSError, ValueError):
            expires = None
    sub = claims.get("sub")
    user_id = sub.strip() if isinstance(sub, str) else None
    return expires, header_value(user_id) if user_id else None


def early_secs() -> int:
    raw = os.environ.get("GROK_AUTH_EARLY_INVALIDATION_SECS", "300")
    try:
        value = int(str(raw).strip())
    except ValueError:
        return 300
    return value if value > 0 else 0


def token_needs_refresh(expires: datetime | None, now: datetime) -> bool:
    if expires is None:
        return False
    return expires <= now + timedelta(seconds=early_secs())


def iter_entries(data: object):
    """Yield (storage key, entry) for each credential record."""
    if isinstance(data, dict):
        nested = [
            (key, value)
            for key, value in data.items()
            if isinstance(value, dict)
        ]
        keyed = [
            (key, entry)
            for key, entry in nested
            if "key" in entry or "access_token" in entry or "refresh_token" in entry
        ]
        if keyed:
            yield from keyed
            return
        if "key" in data or "access_token" in data or "refresh_token" in data:
            yield None, data
        return
    if isinstance(data, list):
        for index, item in enumerate(data):
            if isinstance(item, dict):
                yield index, item


def load_credentials(path: str | None = None, now: datetime | None = None) -> Credentials:
    path = path or auth_file()
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError as exc:
        raise UsageError("not signed in, run grok") from exc
    except (OSError, json.JSONDecodeError, UnicodeError) as exc:
        raise UsageError("can't read login, run grok") from exc

    now = now or datetime.now(timezone.utc)
    found = []
    for entry_key, entry in iter_entries(data):
        token = header_value(entry.get("key")) or header_value(entry.get("access_token"))
        refresh = header_value(entry.get("refresh_token"))
        if not token and not refresh:
            continue
        jwt_exp, jwt_sub = jwt_parts(token) if token else (None, None)
        expires = parse_time(entry.get("expires_at")) or jwt_exp
        user_id = header_value(entry.get("user_id")) or jwt_sub
        issuer = header_value(entry.get("oidc_issuer"))
        client_id = header_value(entry.get("oidc_client_id"))
        expired = (not token) or token_needs_refresh(expires, now)
        creds = Credentials(
            token or "",
            user_id,
            expired,
            refresh,
            issuer,
            client_id,
            entry_key,
            expires,
        )
        found.append((expires or datetime.min.replace(tzinfo=timezone.utc), creds))
    if not found:
        raise UsageError("not signed in, run grok")

    found.sort(key=lambda item: item[0], reverse=True)
    for _when, creds in found:
        if creds.token and not creds.expired:
            return creds
    for _when, creds in found:
        if creds.refresh_token and creds.issuer and creds.client_id:
            return creds
    return found[0][1]


def message_for_status(code: int) -> str:
    if code in (401, 403):
        return EXPIRED_MSG
    if code in (301, 302, 303, 307, 308):
        return "usage endpoint moved"
    return "usage unavailable"


class _RefuseRedirect(urllib.request.HTTPRedirectHandler):
    """Do not follow redirects. A redirect would copy the bearer token."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, msg, headers, fp)


def allowed_url(value: str) -> str:
    """https, or http on loopback so a local test server can stand in."""
    text = value.strip()
    parsed = urllib.parse.urlparse(text)
    host = (parsed.hostname or "").lower()
    loopback = host in {"localhost", "127.0.0.1", "::1"}
    if parsed.username or parsed.password or not parsed.netloc:
        raise UsageError("can't reach Grok")
    if parsed.scheme == "https" or (parsed.scheme == "http" and loopback):
        return text
    raise UsageError("can't reach Grok")


def _read_json(response) -> dict:
    raw = response.read(MAX_BODY + 1)
    if len(raw) > MAX_BODY:
        raise UsageError("can't reach Grok")
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise UsageError("can't reach Grok") from exc
    if not isinstance(payload, dict):
        raise UsageError("can't reach Grok")
    return payload


def http_json(url: str, timeout: int = REQUEST_TIMEOUT) -> dict:
    request = urllib.request.Request(
        allowed_url(url),
        headers={"Accept": "application/json", "User-Agent": "grok-weekly-widget"},
        method="GET",
    )
    opener = urllib.request.build_opener(_RefuseRedirect)
    try:
        with opener.open(request, timeout=timeout) as response:
            return _read_json(response)
    except UsageError:
        raise
    except Exception as exc:
        raise UsageError("can't reach Grok") from exc


def oauth_error_message(raw: bytes) -> str:
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        return "can't reach Grok"
    if not isinstance(payload, dict):
        return "can't reach Grok"
    # These mean the refresh token itself is dead. Anything else is retried.
    if payload.get("error") in {
        "invalid_grant",
        "invalid_client",
        "unauthorized_client",
        "invalid_token",
        "access_denied",
    }:
        return EXPIRED_MSG
    return "can't reach Grok"


def format_stamp(when: datetime) -> str:
    when = when.astimezone(timezone.utc)
    return when.strftime("%Y-%m-%dT%H:%M:%S.") + f"{when.microsecond:06d}000Z"


def expiry_from(access_token: str, expires_in: object, now: datetime) -> datetime:
    jwt_exp, _user = jwt_parts(access_token)
    if jwt_exp is not None:
        return jwt_exp
    if isinstance(expires_in, (int, float)) and not isinstance(expires_in, bool) and expires_in > 0:
        return now + timedelta(seconds=float(expires_in))
    return now + timedelta(hours=1)


def exchange_refresh(creds: Credentials, now: datetime | None = None) -> Credentials:
    """Mint a new access token. The refresh token stays in the POST body."""
    now = now or datetime.now(timezone.utc)
    if not creds.issuer or not creds.client_id or not creds.refresh_token:
        raise UsageError(EXPIRED_MSG)
    document = http_json(creds.issuer.rstrip("/") + "/.well-known/openid-configuration")
    endpoint = document.get("token_endpoint")
    if not isinstance(endpoint, str) or not endpoint.strip():
        raise UsageError("can't reach Grok")
    form = urllib.parse.urlencode(
        {
            "grant_type": "refresh_token",
            "refresh_token": creds.refresh_token,
            "client_id": creds.client_id,
        }
    ).encode("utf-8")
    request = urllib.request.Request(
        allowed_url(endpoint),
        data=form,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Accept": "application/json",
            "User-Agent": "grok-weekly-widget",
        },
        method="POST",
    )
    opener = urllib.request.build_opener(_RefuseRedirect)
    try:
        with opener.open(request, timeout=REQUEST_TIMEOUT) as response:
            payload = _read_json(response)
    except urllib.error.HTTPError as exc:
        body = exc.read(MAX_BODY + 1) if exc.fp else b""
        raise UsageError(oauth_error_message(body)) from exc
    except UsageError:
        raise
    except Exception as exc:
        raise UsageError("can't reach Grok") from exc
    access = header_value(payload.get("access_token"))
    if not access:
        raise UsageError(EXPIRED_MSG)
    refresh = header_value(payload.get("refresh_token")) or creds.refresh_token
    expires = expiry_from(access, payload.get("expires_in"), now)
    return Credentials(
        access,
        creds.user_id,
        token_needs_refresh(expires, now),
        refresh,
        creds.issuer,
        creds.client_id,
        creds.entry_key,
        expires,
    )


@contextlib.contextmanager
def auth_lock(path: str):
    """Serialize with the CLI. A rotated refresh token can only be used once."""
    handle = open(path + ".lock", "a+", encoding="utf-8")
    try:
        deadline = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    raise UsageError("usage unavailable")
                time.sleep(0.2)
        yield
    finally:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        handle.close()


def atomic_write_json(path: str, data: object) -> None:
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(prefix=".auth-", suffix=".tmp", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def save_session(path: str, entry_key, creds: Credentials, now: datetime | None = None) -> None:
    now = now or datetime.now(timezone.utc)
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError, UnicodeError) as exc:
        raise UsageError("can't read login, run grok") from exc
    entry = None
    if isinstance(data, dict) and isinstance(entry_key, str) and isinstance(data.get(entry_key), dict):
        entry = data[entry_key]
    elif (
        isinstance(data, list)
        and isinstance(entry_key, int)
        and 0 <= entry_key < len(data)
        and isinstance(data[entry_key], dict)
    ):
        entry = data[entry_key]
    if entry is None:
        raise UsageError("can't read login, run grok")
    entry["key"] = creds.token
    if "access_token" in entry:
        entry["access_token"] = creds.token
    if creds.refresh_token:
        entry["refresh_token"] = creds.refresh_token
    entry["expires_at"] = format_stamp(creds.expires or (now + timedelta(hours=1)))
    entry["create_time"] = format_stamp(now)
    try:
        atomic_write_json(path, data)
    except OSError as exc:
        raise UsageError("can't read login, run grok") from exc


def refresh_session(failed: Credentials, force: bool = False) -> Credentials:
    path = auth_file()
    with auth_lock(path):
        # Re-read under the lock. The CLI may have renewed the session while we waited.
        current = load_credentials(path)
        if current.token and current.token != failed.token and not current.expired:
            return current
        if not force and current.token and not current.expired:
            return current
        if not current.refresh_token or not current.issuer or not current.client_id:
            raise UsageError(EXPIRED_MSG)
        minted = exchange_refresh(current)
        minted.entry_key = current.entry_key
        save_session(path, current.entry_key, minted)
        return minted


def http_get_billing(creds: Credentials, url: str | None = None, timeout: int = REQUEST_TIMEOUT) -> dict:
    url = url or BILLING_URL
    headers = {
        "Authorization": "Bearer " + creds.token,
        "X-XAI-Token-Auth": TOKEN_AUTH,
        "Accept": "application/json",
        "User-Agent": "grok-weekly-widget",
    }
    if creds.user_id:
        headers["x-userid"] = creds.user_id
    request = urllib.request.Request(url, headers=headers, method="GET")
    opener = urllib.request.build_opener(_RefuseRedirect)
    try:
        with opener.open(request, timeout=timeout) as response:
            raw = response.read(MAX_BODY + 1)
    except urllib.error.HTTPError as exc:
        raise UsageError(message_for_status(exc.code)) from exc
    except Exception as exc:
        raise UsageError("can't reach Grok") from exc
    if len(raw) > MAX_BODY:
        raise UsageError(CHANGED_MSG)
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise UsageError(CHANGED_MSG) from exc
    if not isinstance(payload, dict):
        raise UsageError(CHANGED_MSG)
    return payload


def _containers(payload: dict) -> list:
    if not isinstance(payload, dict):
        return []
    found = []
    config = payload.get("config")
    if isinstance(config, dict):
        found.append(config)
    found.append(payload)
    return found


def find_percent(payload: dict) -> float | None:
    containers = _containers(payload)
    for container in containers:
        percent = as_percent(container.get("creditUsagePercent"))
        if percent is not None:
            return percent
    for container in containers:
        for value in container.values():
            if isinstance(value, dict):
                percent = as_percent(value.get("creditUsagePercent"))
                if percent is not None:
                    return percent
    # productUsage entries are shares of the same weekly pool.
    total = 0.0
    found_product = False
    for container in containers:
        products = container.get("productUsage")
        if not isinstance(products, list):
            continue
        for item in products:
            if not isinstance(item, dict):
                continue
            percent = as_percent(item.get("usagePercent"))
            if percent is None:
                continue
            total += percent
            found_product = True
    if found_product:
        return total
    # A weekly period with no percent is an empty pool. Proto omits the 0.
    if _weekly_period(payload):
        return 0.0
    return None


def _weekly_period(payload: dict) -> bool:
    for container in _containers(payload):
        period = container.get("currentPeriod")
        if not isinstance(period, dict):
            continue
        kind = period.get("type")
        if isinstance(kind, str) and "WEEKLY" in kind:
            return True
    return False


def find_reset(payload: dict) -> datetime | None:
    for container in _containers(payload):
        period = container.get("currentPeriod")
        if isinstance(period, dict):
            resets = parse_time(period.get("end"))
            if resets is not None:
                return resets
        for key in ("billingPeriodEnd", "periodEnd", "resetsAt", "resetAt"):
            resets = parse_time(container.get(key))
            if resets is not None:
                return resets
    return None


def extract_usage(payload: dict) -> Usage:
    percent = find_percent(payload)
    if percent is None:
        raise UsageError(CHANGED_MSG)
    return Usage(percent, find_reset(payload))


def format_percent(value: float) -> str:
    rounded = round(float(value), 1)
    if abs(rounded - round(rounded)) < 1e-9:
        return str(int(round(rounded)))
    return f"{rounded:.1f}"


def format_reset(resets_at: datetime | None) -> str:
    if resets_at is None:
        return ""
    local = resets_at.astimezone()
    return f"resets {MONTHS[local.month - 1]} {local.day}"


def format_line(percent: float, resets_at: datetime | None) -> str:
    shown = format_percent(percent)
    if resets_at is None:
        return f"Grok {shown}% — reset unknown"
    local = resets_at.astimezone()
    when = f"{MONTHS[local.month - 1]} {local.day}"
    return f"Grok {shown}% — resets {when}"


def fetch_usage() -> Usage:
    creds = load_credentials()
    refreshed = False
    if creds.expired or not creds.token:
        creds = refresh_session(creds)
        refreshed = True
    try:
        return extract_usage(http_get_billing(creds))
    except UsageError as exc:
        # One silent refresh after a rejection. A second rejection is shown.
        if exc.message != EXPIRED_MSG or refreshed:
            raise
        creds = refresh_session(creds, force=True)
        return extract_usage(http_get_billing(creds))


def read_usage() -> Result:
    try:
        usage = fetch_usage()
    except UsageError as exc:
        return Result(False, exc.message, None)
    except Exception:
        return Result(False, "usage unavailable", None)
    return Result(True, format_line(usage.percent, usage.resets_at), usage.percent, usage.resets_at)


def bar_color(percent: float) -> str:
    if percent >= 90:
        return RED
    if percent >= 70:
        return AMBER
    return GREEN


def pick_family(root: tk.Misc) -> str:
    families = set(tkfont.families(root))
    for name in ("Nunito Sans", "Nunito", "DejaVu Sans", "Liberation Sans"):
        if name in families:
            return name
    return tkfont.nametofont("TkDefaultFont").cget("family")


def _x_cardinals(x11, display, window: int, name: str):
    """Read a 32-bit X property as a list of ints. Caller owns the display."""
    atom = x11.XInternAtom(display, name.encode(), False)
    actual_type = ctypes.c_ulong()
    actual_format = ctypes.c_int()
    count = ctypes.c_ulong()
    leftover = ctypes.c_ulong()
    raw = ctypes.c_void_p()
    status = x11.XGetWindowProperty(
        display, window, atom, 0, 64, False, 0,
        ctypes.byref(actual_type), ctypes.byref(actual_format),
        ctypes.byref(count), ctypes.byref(leftover), ctypes.byref(raw),
    )
    if status != 0 or not raw or count.value == 0 or actual_format.value != 32:
        if raw:
            x11.XFree(raw)
        return None
    data = ctypes.cast(raw, ctypes.POINTER(ctypes.c_ulong))
    values = [int(data[index]) for index in range(count.value)]
    x11.XFree(raw)
    return values


def bottom_taskbar(screen_w: int, screen_h: int):
    """Return (x, y, width, height) of the widest bottom panel, or None.

    Uses the EWMH strut the panel reserves, so a taskbar on one monitor
    of a wider desktop is not treated as spanning every screen.
    """
    libname = ctypes.util.find_library("X11")
    if not libname:
        return None
    try:
        x11 = ctypes.CDLL(libname)
    except OSError:
        return None
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XInternAtom.restype = ctypes.c_ulong
    x11.XFree.argtypes = [ctypes.c_void_p]
    x11.XGetWindowProperty.argtypes = [
        ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong,
        ctypes.c_long, ctypes.c_long, ctypes.c_int, ctypes.c_ulong,
        ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
        ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
        ctypes.POINTER(ctypes.c_void_p),
    ]
    display = x11.XOpenDisplay(None)
    if not display:
        return None
    try:
        root = x11.XDefaultRootWindow(display)
        clients = _x_cardinals(x11, display, root, "_NET_CLIENT_LIST") or []
        best = None
        for window in clients:
            strut = _x_cardinals(x11, display, window, "_NET_WM_STRUT_PARTIAL")
            if not strut or len(strut) < 12 or strut[3] <= 0:
                continue
            start_x = strut[10]
            end_x = strut[11]
            if end_x < start_x:
                continue
            rect = (start_x, screen_h - int(strut[3]), end_x - start_x + 1, int(strut[3]))
            if rect[2] <= 0 or rect[1] < 0 or rect[1] > screen_h:
                continue
            if best is None or rect[2] > best[2]:
                best = rect
        if best is None:
            return None
        # Ignore a strut that does not actually sit on this screen.
        if best[0] >= screen_w or best[1] >= screen_h:
            return None
        return best
    except Exception:
        return None
    finally:
        x11.XCloseDisplay(display)


def _x_change(x11, display, window: int, prop: str, prop_type: int, data, count: int) -> None:
    atom = x11.XInternAtom(display, prop.encode(), False)
    x11.XChangeProperty(
        display, window, atom, prop_type, 32, 0,
        ctypes.cast(data, ctypes.POINTER(ctypes.c_ubyte)), count,
    )


def pin_to_desktop(window_id: int) -> None:
    """Make this toplevel behave like Conky.

    Hints have to be set on Tk's outer window (the parent of winfo_id),
    which is the one Openbox manages. Type "desktop" sinks under the
    wallpaper on this session, so the window stays a normal undecorated
    window with the below state.
    """
    libname = ctypes.util.find_library("X11")
    if not libname:
        return
    try:
        x11 = ctypes.CDLL(libname)
    except OSError:
        return
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XInternAtom.restype = ctypes.c_ulong
    x11.XQueryTree.restype = ctypes.c_int
    x11.XQueryTree.argtypes = [
        ctypes.c_void_p, ctypes.c_ulong,
        ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
        ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_uint),
    ]
    display = x11.XOpenDisplay(None)
    if not display:
        return
    try:
        root = x11.XDefaultRootWindow(display)
        targets = [int(window_id)]
        parent = ctypes.c_ulong()
        root_ret = ctypes.c_ulong()
        children = ctypes.c_void_p()
        count = ctypes.c_uint()
        if x11.XQueryTree(
            display, int(window_id),
            ctypes.byref(root_ret), ctypes.byref(parent),
            ctypes.byref(children), ctypes.byref(count),
        ):
            if children:
                x11.XFree(children)
            parent_id = int(parent.value)
            if parent_id and parent_id not in (int(root), int(window_id)):
                targets.append(parent_id)

        class MotifHints(ctypes.Structure):
            _fields_ = [
                ("flags", ctypes.c_ulong),
                ("functions", ctypes.c_ulong),
                ("decorations", ctypes.c_ulong),
                ("input_mode", ctypes.c_long),
                ("status", ctypes.c_ulong),
            ]

        hints = MotifHints(2, 0, 0, 0, 0)
        states = (ctypes.c_ulong * 4)(*(
            x11.XInternAtom(display, name.encode(), False)
            for name in (
                "_NET_WM_STATE_BELOW",
                "_NET_WM_STATE_SKIP_TASKBAR",
                "_NET_WM_STATE_SKIP_PAGER",
                "_NET_WM_STATE_STICKY",
            )
        ))
        normal = (ctypes.c_ulong * 1)(x11.XInternAtom(display, "_NET_WM_WINDOW_TYPE_NORMAL".encode(), False))
        xa_atom = 4
        motif = x11.XInternAtom(display, "_MOTIF_WM_HINTS".encode(), False)
        for target in targets:
            _x_change(x11, display, target, "_MOTIF_WM_HINTS", motif, ctypes.byref(hints), 5)
            _x_change(x11, display, target, "_NET_WM_STATE", xa_atom, states, 4)
            _x_change(x11, display, target, "_NET_WM_WINDOW_TYPE", xa_atom, normal, 1)
        x11.XFlush(display)
    except Exception:
        return
    finally:
        x11.XCloseDisplay(display)


class UsageWidget(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title("Grok usage")
        self.configure(bg=BORDER)
        self.resizable(False, False)
        with contextlib.suppress(tk.TclError):
            self.attributes("-alpha", ALPHA)

        self._percent: float | None = None
        self._queue: queue.Queue = queue.Queue()
        self._lock = threading.Lock()
        self._alive = True
        self._timer: str | None = None

        family = pick_family(self)
        title_font = tkfont.Font(family=family, size=9, weight="bold")
        row_font = tkfont.Font(family=family, size=10)
        pct_font = tkfont.Font(family=family, size=10, weight="bold")
        small_font = tkfont.Font(family=family, size=9)

        outer = tk.Frame(self, bg=BORDER, padx=1, pady=1)
        outer.pack(fill="both", expand=True)
        inner = tk.Frame(outer, bg=BG, padx=PAD_X, pady=PAD_Y)
        inner.pack(fill="both", expand=True)

        head = tk.Frame(inner, bg=BG)
        head.pack(fill="x", pady=(0, 4))
        tk.Label(head, text="●", bg=BG, fg=ACCENT, font=small_font).pack(side="left")
        tk.Label(head, text="GROK", bg=BG, fg=FG, font=title_font).pack(side="left", padx=(4, 0))
        self.updated = tk.Label(head, text="", bg=BG, fg=FG_MUTED, font=small_font)
        self.updated.pack(side="right")

        self.row = tk.Frame(inner, bg=BG)
        self.row.pack(fill="x")
        tk.Label(self.row, text="Week", bg=BG, fg=FG_DIM, font=row_font).pack(side="left")
        self.pct = tk.Label(self.row, text="…", bg=BG, fg=FG, font=pct_font)
        self.pct.pack(side="left", padx=(6, 0))
        self.reset = tk.Label(self.row, text="", bg=BG, fg=FG_MUTED, font=small_font)
        self.reset.pack(side="right")
        self.error = tk.Label(
            self.row, text="", bg=BG, fg=ERROR_FG, font=row_font, anchor="w", justify="left",
            wraplength=CARD_W - PAD_X * 2 - 2,
        )
        self.bar = tk.Canvas(inner, height=BAR_H, bg=BG, highlightthickness=0, bd=0)
        self.bar.pack(fill="x", pady=(3, 0))
        self._row_widgets = [child for child in self.row.winfo_children() if child is not self.error]

        self._panel = self._wait_for_taskbar()
        self._sync_place()
        pin_to_desktop(self.winfo_id())

        self.bar.bind("<Configure>", lambda _event: self._draw_bar())
        # No title bar, so there is no close button. Ignore a delete
        # request so a window manager cannot dismiss it by accident.
        self.protocol("WM_DELETE_WINDOW", lambda: None)

        self.refresh_now()
        self._arm_timer()
        self.after(150, self._poll)
        self.after(400, lambda: pin_to_desktop(self.winfo_id()))
        self.after(PLACE_MS, self._place_tick)

    def _wait_for_taskbar(self):
        """At login the panel may not have set its strut yet."""
        screen_w = self.winfo_screenwidth()
        screen_h = self.winfo_screenheight()
        panel = bottom_taskbar(screen_w, screen_h)
        deadline = time.time() + 12
        while panel is None and time.time() < deadline:
            time.sleep(0.4)
            panel = bottom_taskbar(screen_w, screen_h)
        return panel

    def _sync_place(self) -> None:
        if not self._alive:
            return
        self.update_idletasks()
        height = self.winfo_reqheight()
        screen_w = self.winfo_screenwidth()
        screen_h = self.winfo_screenheight()
        panel = self._panel
        if panel:
            panel_x, panel_y, panel_w, _panel_h = panel
            x = panel_x + panel_w - CARD_W - EDGE_GAP
            y = panel_y - PANEL_GAP - height
            x = min(max(x, panel_x), max(panel_x, panel_x + panel_w - CARD_W))
        else:
            x = screen_w - CARD_W - EDGE_GAP
            y = screen_h - height - 8
        self.geometry(f"{CARD_W}x{height}+{max(0, x)}+{max(0, y)}")

    def _place_tick(self) -> None:
        if not self._alive:
            return
        self._panel = bottom_taskbar(self.winfo_screenwidth(), self.winfo_screenheight()) or self._panel
        self._sync_place()
        self.after(PLACE_MS, self._place_tick)

    def _arm_timer(self, delay_ms: int = REFRESH_MS) -> None:
        if not self._alive:
            return
        if self._timer is not None:
            self.after_cancel(self._timer)
            self._timer = None
        self._timer = self.after(delay_ms, self._on_timer)

    def _on_timer(self) -> None:
        self._timer = None
        self.refresh_now()
        self._arm_timer()

    def refresh_now(self) -> None:
        if not self._alive:
            return
        if not self._lock.acquire(blocking=False):
            return
        threading.Thread(target=self._worker, daemon=True).start()

    def _worker(self) -> None:
        try:
            self._queue.put(read_usage())
        finally:
            self._lock.release()

    def _poll(self) -> None:
        if not self._alive:
            return
        latest = None
        try:
            while True:
                latest = self._queue.get_nowait()
        except queue.Empty:
            pass
        if latest is not None:
            self.apply(latest)
        self.after(200, self._poll)

    def _show_error(self, error: bool) -> None:
        for widget in self._row_widgets + [self.error]:
            widget.pack_forget()
        if error:
            self.error.pack(side="left", fill="x", expand=True)
            return
        name, pct, reset = self._row_widgets
        name.pack(side="left")
        pct.pack(side="left", padx=(6, 0))
        reset.pack(side="right")

    def apply(self, result: Result) -> None:
        text = result.text if isinstance(result.text, str) and result.text else "usage unavailable"
        percent = result.percent if isinstance(result.percent, (int, float)) and not isinstance(result.percent, bool) else None
        self._percent = float(percent) if percent is not None else None
        if result.ok and self._percent is not None:
            self.pct.configure(text=f"{format_percent(self._percent)}%", fg=bar_color(self._percent))
            self.reset.configure(text=format_reset(result.resets_at))
            self.updated.configure(text=datetime.now().strftime("%-I:%M%p").lower())
            self._show_error(False)
        else:
            self.error.configure(text=text)
            self.updated.configure(text="retrying")
            self._show_error(True)
        self._draw_bar()
        self._sync_place()
        # A fresh login does not restart the widget. Recheck quickly until it works.
        if not result.ok:
            self._arm_timer(RETRY_MS)

    def _draw_bar(self) -> None:
        width = self.bar.winfo_width()
        height = self.bar.winfo_height()
        if width < height * 2 or height < 2:
            return
        self.bar.delete("all")
        mid = height / 2
        # A round-capped line is the cheapest rounded bar Tk can draw.
        self.bar.create_line(mid, mid, width - mid, mid, width=height, fill=TRACK, capstyle="round")
        if self._percent is None:
            return
        fraction = max(0.0, min(self._percent, 100.0)) / 100.0
        end = mid + (width - height) * fraction
        if fraction > 0:
            self.bar.create_line(
                mid, mid, end, mid, width=height, fill=bar_color(self._percent), capstyle="round",
            )


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["--once"]:
        result = read_usage()
        print(result.text)
        return 0 if result.ok else 1
    if args:
        print("usage: grok-weekly-widget [--once]", file=sys.stderr)
        return 2
    os.makedirs(os.path.expanduser("~/.cache"), mode=0o700, exist_ok=True)
    lock_path = os.path.expanduser("~/.cache/grok-weekly-widget.lock")
    lock_file = open(lock_path, "a", encoding="utf-8")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("grok-weekly-widget is already running", file=sys.stderr)
        return 0
    try:
        widget = UsageWidget()
    except tk.TclError as exc:
        print(f"can't open a window: {exc}", file=sys.stderr)
        return 1
    widget.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
